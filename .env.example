# Nastavení Google Kalendáře pro SVJ Letohradská 367/5
# Zadejte ID Google Kalendáře (najdete v Google Kalendář -> Nastavení kalendáře -> Integrovat kalendář -> ID kalendáře)
GOOGLE_CALENDAR_ID=vase-svj-kalendar-id@group.calendar.google.com

# Cesta k JSON souboru se servisním účtem Google (výchozí: service_account.json v kořeni projektu)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Přímý přístup ke Gmailu (Heslo pro aplikaci z myaccount.google.com/apppasswords)
GMAIL_USER=nikabrozova@gmail.com
GMAIL_APP_PASSWORD=vase_16mistne_heslo
